# Copy to .env for local use. Never put real secrets in GitHub.
NODE_ENV=development
PORT=3002
FRONTEND_ORIGIN=http://localhost:5173,https://spk-nuansa-wangi.vercel.app
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SPKNuansaWangi
DB_USER=spk_app
DB_PASSWORD=

# Generate a private random value of at least 32 bytes for a deployed backend.
SESSION_SECRET=replace-with-a-private-random-value-at-least-32-bytes

# Database cloud (Aiven): DB_SSL=true, DB_SSL_CA_FILE=/etc/secrets/aiven-ca.pem
# DB_SSL=true
# DB_SSL_CA_FILE=
