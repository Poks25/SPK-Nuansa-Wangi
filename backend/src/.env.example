# Salin file ini menjadi .env untuk pengembangan lokal.
# Jangan commit .env atau membagikan nilainya.
PORT=3002
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Sesi login — buat secret acak minimal 32 karakter.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Akun disimpan sebagai hash pada tabel `users` dan dikelola dari menu Admin.
# Kode pemulihan dibuat dengan `npm run auth:recovery-code` dari folder backend.
# AUTH_RECOVERY_CODE_HASH tidak perlu ditambahkan manual; perintah tersebut mengelolanya.

# MySQL XAMPP — gunakan database lokal yang sudah diaudit; jangan jalankan skema inventaris lama pada database live.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SPKNuansaWangi
DB_USER=spk_app
DB_PASSWORD=SET_LOCALLY
